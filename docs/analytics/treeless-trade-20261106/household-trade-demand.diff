+  private collectHouseholdTradeDemand(goods: Good[]): Map<number, Map<number, number>> {
+    const priced = goods.filter(good => isPricedByHouseholdDemand(good) && !isOrchardDrink(good.name));
+    const casks = goods.find(good => good.name === "Barrels");
+    const byMarket = new Map<number, Map<number, number>>();
+    for (const market of getMarkets()) {
+      const demand = new Map<number, number>();
+      for (const good of priced) {
+        const units = getMonthlyHouseholdDemand(market, good.name);
+        if (units > 0) demand.set(good.i, units);
+      }
+      if (casks) {
+        const units = getMonthlyHouseholdContainerDemand(market, casks);
+        if (units > 0) demand.set(casks.i, units);
+      }
+      if (demand.size) byMarket.set(market.i, demand);
+    }
+    return byMarket;
+  }
