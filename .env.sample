VITE_USE_CUSTOM_ABOUT=true

# Off by default. Records a deep-cloned snapshot of every state/burg on every
# calendar day during Advance Time (dev builds only), for war/combat-debugging
# time-travel via the Debug Snapshot panel. Unbounded and never pruned within
# a session, so leaving it on makes each subsequent Advance Month/Year call
# slower than the last. Set to true only while debugging a war/combat issue.
# VITE_ENABLE_DEBUG_SNAPSHOTS=true
