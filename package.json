{
  "name": "fantasy-map-generator",
  "version": "1.122.12",
  "description": "Azgaar's _Fantasy Map Generator_ is a free web application that helps fantasy writers, game masters, and cartographers create and edit fantasy maps.",
  "homepage": "https://github.com/Azgaar/Fantasy-Map-Generator#readme",
  "bugs": {
    "url": "https://github.com/Azgaar/Fantasy-Map-Generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azgaar/Fantasy-Map-Generator.git"
  },
  "license": "MIT",
  "author": "Azgaar",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:economy": "vite build -c vite.extension.config.ts",
    "setup": "npm install --legacy-peer-deps",
    "package:economy": "npm run build:economy && tsx scripts/package-extension.ts economy",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check --write && npm run lint:legacy",
    "lint:legacy": "tsx scripts/lint-legacy-ui.ts && npm run lint:world-writers && npm run lint:architecture && npm run lint:sim-boundary",
    "lint:world-writers": "tsx scripts/lint-world-writers.ts",
    "lint:architecture": "tsx scripts/lint-architecture.ts",
    "lint:sim-boundary": "tsx scripts/lint-sim-boundary.ts",
    "test:sim-golden": "tsx scripts/simGolden.mts",
    "sim": "tsx scripts/sim.mts",
    "sim:server": "tsx scripts/simServer.mts",
    "observe": "tsx scripts/observe.mts",
    "lint:fix": "biome check --write --unsafe",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src/app.ts",
    "prepare": "simple-git-hooks",
    "analyze-globals": "tsx scripts/analyze-window-globals.ts",
    "convert-global": "tsx scripts/convert-global.ts",
    "perf:webgl-layers": "tsx scripts/benchmarkWebglLayers.ts",
    "perf:advance-year": "tsx scripts/benchmarkAdvanceYear.ts",
    "calibrate:land-connections": "node --import tsx scripts/calibrateLandConnections.ts",
    "calibrate:fast-advance": "tsx scripts/calibrateFastAdvance.ts",
    "diagnose:treasury": "tsx scripts/diagnoseTreasuryDecline.ts",
    "diagnose:wealth": "tsx scripts/diagnoseCharacterWealth.ts",
    "extract:fmg": "node --import tsx scripts/extractFmgArchive.ts",
    "housing:compare": "node scripts/compareBurgHousing.mjs",
    "races:import": "node --import tsx scripts/races-csv.ts import",
    "races:export": "node --import tsx scripts/races-csv.ts export",
    "races:check": "node --import tsx scripts/races-csv.ts check",
    "prebuild": "npm run races:import",
    "prebuild:economy": "npm run races:import",
    "races:relations:import": "node --import tsx scripts/races-csv.ts import-relations",
    "races:relations:export": "node --import tsx scripts/races-csv.ts export-relations",
    "build:characters": "FMG_EXTENSION=characters vite build -c vite.extension.config.ts",
    "prebuild:characters": "npm run races:import",
    "test:race-bundles": "node --import tsx scripts/check-race-bundles.ts",
    "housing:export": "node scripts/housingBatch.mjs export",
    "housing:batch": "node scripts/housingBatch.mjs compare",
    "ce:audit": "node --import tsx scripts/auditCityGeneration.mjs",
    "ce:perf": "node --import tsx scripts/benchmarkFmgCities.mjs",
    "ce:perf:csv": "node --import tsx scripts/cePerformanceCsv.mjs",
    "ce:perf:query": "node scripts/cePerformanceQuery.mjs",
    "fmg:perf": "node scripts/benchmarkFmgGeneration.mjs",
    "fmg:small": "node scripts/generateSmallMaps.mjs",
    "lab:classify": "node scripts/labClassify.mjs",
    "lab:collect": "node scripts/labCollect.mjs",
    "lab:report": "node scripts/labReport.mjs",
    "lab:csv": "node scripts/labCsv.mjs",
    "map:server": "node scripts/mapServer.mjs",
    "ce:wall-lab": "node --import tsx scripts/wallRingLab.ts",
    "ce:terrain-perf": "node --import tsx scripts/ceTerrainPerf.ts",
    "ce:freeform-perf": "node --import tsx scripts/ceFreeformPerf.ts",
    "ce:freeform-frame": "node --import tsx scripts/ceFreeformFrame.mts",
    "ce:freeform-real-frame": "node --import tsx scripts/ceFreeformRealFrame.mts",
    "ce:wall-order": "node scripts/compareTownWallOrders.mjs",
    "audit:fmg-cities": "node --import tsx scripts/auditFmgCityContext.ts",
    "test:fmg-audit": "node --import tsx --test scripts/lib/fmgCityAudit/audit.test.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run lint:legacy"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/d3": "^7.4.3",
    "@types/delaunator": "^5.1.0",
    "@types/jscodeshift": "^17.3.0",
    "@types/lineclip": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/tinymce": "^5.5.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "jscodeshift": "^17.4.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "simple-git-hooks": "^2.14.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/extensions": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@stdlib/math-base-special-acos": "0.2.4",
    "@stdlib/math-base-special-asin": "0.2.4",
    "@stdlib/math-base-special-asinh": "0.2.4",
    "@stdlib/math-base-special-atan": "0.2.4",
    "@stdlib/math-base-special-atan2": "0.3.1",
    "@stdlib/math-base-special-cbrt": "0.2.3",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-exp": "0.2.5",
    "@stdlib/math-base-special-expm1": "0.2.4",
    "@stdlib/math-base-special-hypot": "0.2.4",
    "@stdlib/math-base-special-ln": "0.2.5",
    "@stdlib/math-base-special-log10": "0.3.1",
    "@stdlib/math-base-special-log1p": "0.2.4",
    "@stdlib/math-base-special-log2": "0.3.1",
    "@stdlib/math-base-special-pow": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "@stdlib/math-base-special-tan": "0.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tinymce/tinymce-react": "^6.3.1",
    "alea": "^1.0.1",
    "d3": "^7.9.2",
    "delaunator": "^5.1.0",
    "driver.js": "^1.10.2",
    "dropbox": "^10.66.0",
    "fflate": "^0.8.3",
    "flatqueue": "^3.1.0",
    "i18next": "^27.0.1",
    "jszip": "^3.10.2",
    "lineclip": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.1.0",
    "rbush": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "rgbquant": "^1.1.2",
    "simplify-js": "^1.2.4",
    "three": "^0.187.0",
    "three-subdivide": "^1.1.5",
    "tinymce": "^8.10.1",
    "zustand": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
