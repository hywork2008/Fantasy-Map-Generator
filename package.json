{
  "name": "fantasy-map-generator",
  "version": "1.122.12",
  "description": "Azgaar's _Fantasy Map Generator_ is a free web application that helps fantasy writers, game masters, and cartographers create and edit fantasy maps.",
  "homepage": "https://github.com/Azgaar/Fantasy-Map-Generator#readme",
  "bugs": {
    "url": "https://github.com/Azgaar/Fantasy-Map-Generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azgaar/Fantasy-Map-Generator.git"
  },
  "license": "MIT",
  "author": "Azgaar",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:economy": "vite build -c vite.extension.config.ts",
    "setup": "npm install --legacy-peer-deps",
    "package:economy": "npm run build:economy && tsx scripts/package-extension.ts economy",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check --write && npm run lint:legacy",
    "lint:legacy": "tsx scripts/lint-legacy-ui.ts && npm run lint:world-writers && npm run lint:architecture",
    "lint:world-writers": "tsx scripts/lint-world-writers.ts",
    "lint:architecture": "tsx scripts/lint-architecture.ts",
    "lint:fix": "biome check --write --unsafe",
    "madge": "madge --circular --extensions ts,tsx src/app.ts",
    "prepare": "simple-git-hooks",
    "analyze-globals": "tsx scripts/analyze-window-globals.ts",
    "convert-global": "tsx scripts/convert-global.ts",
    "perf:webgl-layers": "tsx scripts/benchmarkWebglLayers.ts",
    "perf:advance-year": "tsx scripts/benchmarkAdvanceYear.ts",
    "diagnose:wealth": "tsx scripts/diagnoseCharacterWealth.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run lint:legacy"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.1",
    "@types/d3": "^7.4.3",
    "@types/delaunator": "^5.0.3",
    "@types/jscodeshift": "^17.3.0",
    "@types/lineclip": "^2.0.0",
    "@types/node": "^26.1.2",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@types/tinymce": "^5.5.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jscodeshift": "^17.4.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "playwright": "^1.62.1",
    "simple-git-hooks": "^2.13.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/extensions": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@tanstack/react-virtual": "^3.14.9",
    "@tinymce/tinymce-react": "^6.3.0",
    "alea": "^1.0.1",
    "d3": "^7.9.0",
    "delaunator": "^5.1.0",
    "driver.js": "^1.8.0",
    "dropbox": "^10.40.0",
    "flatqueue": "^3.1.0",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "lineclip": "^2.0.0",
    "polylabel": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "rgbquant": "^1.1.2",
    "simplify-js": "^1.2.4",
    "three": "^0.185.1",
    "three-subdivide": "^1.1.5",
    "tinymce": "^8.8.2",
    "zustand": "^5.0.14"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}