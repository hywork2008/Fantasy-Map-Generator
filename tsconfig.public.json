{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "rootDir": "packages/@fmg/legacy-ui/src",
    "outDir": "public",
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": [
    "packages/@fmg/legacy-ui/src/components/fill-box.ts",
    "packages/@fmg/legacy-ui/src/components/slider-input.ts",
    "packages/@fmg/legacy-ui/src/config/heightmap-templates.ts",
    "packages/@fmg/legacy-ui/src/config/precreated-heightmaps.ts"
  ]
}
